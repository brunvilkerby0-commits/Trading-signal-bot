
services:
  - type: web
    name: smartasset-pocket-signal
    runtime: node
    plan: free

    buildCommand: npm install
    startCommand: npm start

    envVars:
      - key: TWELVE_DATA_API_KEY
        sync: false

      - key: TELEGRAM_BOT_TOKEN
        sync: false

      - key: TELEGRAM_CHAT_ID
        value: "@smartasset_vip_signal"
